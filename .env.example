# Ambiente applicativo: development | production
APP_ENV=development

# Database locale SQLite (percorso relativo alla root del progetto)
DATABASE_URL=sqlite:///./data/leads.db

# Provider di discovery: mock | google
DISCOVERY_PROVIDER=mock

# Chiave ufficiale Google Maps Platform (Places + Geocoding).
# Lasciare vuoto per usare il provider mock.
GOOGLE_MAPS_API_KEY=

# Ultima città usata come suggerimento nell'UI. L'epicentro si imposta a ogni ricerca.
SEARCH_CITY=
SEARCH_COUNTRY=Italy
SEARCH_POSTAL_CODE=
# SEARCH_LATITUDE=
# SEARCH_LONGITUDE=
SEARCH_RADIUS_KM=10

# Limiti operativi
MAX_RESULTS_PER_QUERY=40
REQUEST_TIMEOUT_SECONDS=10
CRAWL_MAX_PAGES_PER_DOMAIN=4
CRAWL_DELAY_SECONDS=1.0
HTTP_USER_AGENT=LeadFinder/1.0 (+local-research; respect-robots)

# Job in background
JOB_POLL_SECONDS=1.0
